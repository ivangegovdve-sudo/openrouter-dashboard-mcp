{
  "name": "open-dashboard-mcp",
  "version": "0.8.0",
  "description": "Read-only MCP comparing models on OpenRouter, Groq, Cerebras, Sail, QwenCloud, DeepInfra, Novita, SambaNova and Chutes by price, capability and retirement risk, plus GitHub trending; it refuses to quote Sail prices when its pinned document changes.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openrouter",
    "groq",
    "cerebras",
    "llm",
    "model-routing",
    "pricing",
    "llm-pricing",
    "claude",
    "github-trending",
    "trending"
  ],
  "license": "MIT",
  "author": "Ivan Gegov",
  "type": "module",
  "bin": {
    "open-dashboard-mcp": "./build/index.js"
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run typecheck:harness",
    "test": "tsx --test",
    "test:watch": "tsx --test --watch",
    "typecheck:harness": "tsc -p tsconfig.harness.json",
    "verify:stdio": "tsx scripts/verify-stdio.ts",
    "verify:stdout": "tsx scripts/verify-stdout.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "homepage": "https://sdforest.site/web/open-dashboard/mcp/"
}
