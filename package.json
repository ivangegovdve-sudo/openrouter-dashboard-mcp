{
  "name": "open-dashboard-mcp",
  "version": "1.4.0",
  "description": "MCP: OpenRouter, Groq, Cerebras, Sail, Nous Research, QwenCloud, DeepInfra, Novita, SambaNova, Chutes, WaveSpeedAI, fal, Crazyrouter, AkashML, io.net. Refuses to quote Sail prices; catalogue arithmetic is not generation cost. GitHub trending.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openrouter",
    "groq",
    "cerebras",
    "llm",
    "model-routing",
    "pricing",
    "llm-pricing",
    "claude",
    "github-trending",
    "trending",
    "akashml",
    "io.net"
  ],
  "license": "MIT",
  "author": "Ivan Gegov",
  "type": "module",
  "bin": {
    "open-dashboard-mcp": "./build/index.js"
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "docs/jev-routing-example.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run typecheck:harness && npm run docs:generate",
    "test": "tsx --test --test-concurrency=1 \"test/**/*.test.ts\" \"src/providers/provider-openness.test.ts\"",
    "test:watch": "tsx --test --test-concurrency=1 --watch \"test/**/*.test.ts\" \"src/providers/provider-openness.test.ts\"",
    "typecheck:harness": "tsc -p tsconfig.harness.json",
    "verify:stdio": "tsx scripts/verify-stdio.ts",
    "verify:stdout": "tsx scripts/verify-stdout.ts",
    "prepublishOnly": "npm run docs:check && npm run build && npm test",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "docs:check": "tsx scripts/generate-docs.ts --check",
    "verify:catalogue": "tsx scripts/verify-catalogue-stdio.ts",
    "smoke:capability-state": "tsx scripts/smoke-capability-state.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "playwright": "1.63.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "homepage": "https://www.sdforest.site/web/open-dashboard/",
  "exports": {
    ".": "./build/index.js",
    "./contract-vocabulary.json": "./build/contract-vocabulary.json",
    "./package.json": "./package.json"
  }
}
