{
  "name": "open-dashboard-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP: OpenRouter, Groq, Cerebras, Sail, QwenCloud, DeepInfra, Novita, SambaNova, Chutes, WaveSpeedAI, fal, Crazyrouter; media and token prices, caveats, GitHub trending. It refuses to quote Sail prices if its document changes.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openrouter",
    "groq",
    "cerebras",
    "llm",
    "model-routing",
    "pricing",
    "llm-pricing",
    "claude",
    "github-trending",
    "trending"
  ],
  "license": "MIT",
  "author": "Ivan Gegov",
  "type": "module",
  "bin": {
    "open-dashboard-mcp": "./build/index.js"
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run typecheck:harness && npm run docs:generate",
    "test": "tsx --test",
    "test:watch": "tsx --test --watch",
    "typecheck:harness": "tsc -p tsconfig.harness.json",
    "verify:stdio": "tsx scripts/verify-stdio.ts",
    "verify:stdout": "tsx scripts/verify-stdout.ts",
    "prepublishOnly": "npm run docs:check && npm run build && npm test",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "docs:check": "tsx scripts/generate-docs.ts --check",
    "verify:catalogue": "tsx scripts/verify-catalogue-stdio.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "homepage": "https://sdforest.site/web/open-dashboard/mcp/",
  "exports": {
    ".": "./build/index.js",
    "./contract-vocabulary.json": "./build/contract-vocabulary.json"
  }
}
